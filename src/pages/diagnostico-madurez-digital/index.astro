---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Assessment from '../../components/Assessment.astro';

const title = 'Diagnóstico de Madurez Digital para empresas chilenas';
const description = 'Responde 20 preguntas en 8 minutos para conocer la madurez digital de tu empresa y descubrir qué mejorar primero.';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Diagnóstico de Madurez Digital — Apps del Sur', description,
  url: 'https://appsdelsur.cl/diagnostico-madurez-digital/', applicationCategory: 'BusinessApplication', operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CLP' }, provider: { '@type': 'Organization', name: 'Apps del Sur', url: 'https://appsdelsur.cl' }, inLanguage: 'es-CL',
});
---

<Layout title={`${title} | Apps del Sur`} description={description} canonical="https://appsdelsur.cl/diagnostico-madurez-digital/">
  <script type="application/ld+json" set:html={jsonLd} />
  <Header />
  <Assessment type="digital" />
  <section class="assessment-more" aria-labelledby="assessment-more-title">
    <h2 id="assessment-more-title">¿Qué mide este diagnóstico?</h2>
    <p>Evalúa estrategia, clientes, procesos, datos y herramientas a partir de situaciones cotidianas de la empresa. Al finalizar verás tu etapa, una comparación por dimensión y acciones sugeridas. Es una autoevaluación orientativa, no una auditoría.</p>
    <h3>¿Qué hago si mi empresa ya tiene una base digital sólida?</h3>
    <p>Si obtienes resultados altos en Digital Conectada u Optimizada, puedes continuar con el <a href="/diagnostico-madurez-ia/">Diagnóstico de Madurez en IA</a> para evaluar la preparación del equipo y los procesos para incorporar inteligencia artificial.</p>
  </section>
  <Footer />
</Layout>
