---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ContactForm from '../components/ContactForm.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Check from '../components/icons/Check.astro';
import ArrowRight from '../components/icons/ArrowRight.astro';
import Layers from '../components/icons/Layers.astro';
import Shield from '../components/icons/Shield.astro';
import Sparkle from '../components/icons/Sparkle.astro';
import MapPin from '../components/icons/MapPin.astro';
import { nosotrosPage } from '../data/content';

const principleIconMap: Record<string, any> = {
  layers: Layers,
  shield: Shield,
  sparkle: Sparkle,
  'map-pin': MapPin,
};

const { meta, hero, principles, experience, projects, products } = nosotrosPage;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: meta.ogTitle,
  description: meta.description,
  url: 'https://appsdelsur.cl/nosotros/',
  publisher: { '@id': 'https://appsdelsur.cl/#organization' },
});
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical="https://appsdelsur.cl/nosotros/"
  keywords={meta.keywords}
  ogTitle={meta.ogTitle}
  ogDescription={meta.description}
>
  <script type="application/ld+json" set:html={jsonLd} />

  <Header />

  <main id="main-content" class="pt-24">
    <!-- Breadcrumb -->
    <div class="max-w-[1200px] mx-auto px-6 mb-6">
      <nav class="text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="text-emerald-600 hover:text-emerald-700 transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-gray-400">Quiénes somos</span>
      </nav>
    </div>

    <!-- Hero -->
    <section class="pt-4 pb-20">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="flex flex-col lg:flex-row lg:items-center gap-12">
          <div class="w-full lg:w-3/5">
            <Badge class="mb-4">{hero.badge}</Badge>
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 tracking-tight leading-tight mb-6">
              {hero.titleLine1}{' '}
              <span class="text-emerald-700">{hero.titleHighlight}</span>
            </h1>
            <p class="text-lg text-gray-600 leading-relaxed max-w-[620px]">
              {hero.description}
            </p>
          </div>
          <div class="w-full lg:w-2/5">
            <dl class="rounded-2xl border border-emerald-100 bg-emerald-50/60 p-7 grid sm:grid-cols-2 lg:grid-cols-1 gap-5">
              {hero.facts.map((fact) => (
                <div>
                  <dt class="text-xs text-emerald-700 uppercase tracking-wider font-medium mb-1">{fact.label}</dt>
                  <dd class="text-gray-900 font-semibold">{fact.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-[1200px] mx-auto px-6">
        <SectionHeader label={principles.label} title={principles.title} />
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {principles.items.map((item) => {
            const IconComponent = principleIconMap[item.icon];
            return (
              <div class="rounded-xl border border-gray-200 bg-white p-7">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center mb-5">
                  {IconComponent && <IconComponent class="w-6 h-6" />}
                </div>
                <h3 class="font-semibold text-gray-900 text-lg mb-2">{item.title}</h3>
                <p class="text-sm text-gray-600 leading-relaxed">{item.description}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="py-20 bg-emerald-900 text-white">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="max-w-[760px] mb-12">
          <p class="text-sm font-medium text-emerald-300 mb-2">{experience.label}</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-5">{experience.title}</h2>
          <p class="text-emerald-100 text-lg leading-relaxed">{experience.description}</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {experience.highlights.map((h) => (
            <div class="rounded-xl bg-emerald-800/60 border border-emerald-700 p-6">
              <div class="text-xl font-bold text-white mb-1">{h.value}</div>
              <div class="text-sm text-emerald-200">{h.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    {projects.items.length > 0 && (
      <section class="py-20 bg-white">
        <div class="max-w-[1200px] mx-auto px-6">
          <SectionHeader label={projects.label} title={projects.title} description={projects.description} />
          <div class="grid md:grid-cols-2 gap-6">
            {projects.items.map((p) => (
              <article class="rounded-xl border border-gray-200 bg-white p-7 flex flex-col">
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="inline-flex px-2.5 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-medium">{p.tag}</span>
                  {p.status && (
                    <span class="inline-flex px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-medium">{p.status}</span>
                  )}
                </div>
                <p class="text-sm font-medium text-emerald-700 mb-1">{p.client}</p>
                <h3 class="font-semibold text-gray-900 text-lg mb-2">{p.title}</h3>
                <p class="text-sm text-gray-600 leading-relaxed">{p.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Own products -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-[1200px] mx-auto px-6">
        <SectionHeader label={products.label} title={products.title} description={products.description} />
        <div class="grid lg:grid-cols-2 gap-6">
          {products.items.map((product) => (
            <article class="rounded-2xl border border-gray-200 bg-white p-8 flex flex-col">
              <div class="flex items-center gap-3 mb-1">
                <h3 class="text-2xl font-bold text-gray-900">{product.name}</h3>
                <span class="inline-flex px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-medium">En etapa demostrativa</span>
              </div>
              <p class="text-emerald-700 font-medium mb-4">{product.tagline}</p>
              <p class="text-gray-600 leading-relaxed mb-5">{product.description}</p>
              <ul class="space-y-2 mb-7 flex-1">
                {product.points.map((point) => (
                  <li class="flex gap-2.5 text-sm text-gray-700">
                    <Check class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <Button href={product.href} variant="outline" class="self-start">
                {product.cta}
                <ArrowRight class="w-4 h-4 shrink-0" />
              </Button>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ContactCTA />
    <ContactForm />
  </main>

  <Footer />
</Layout>
