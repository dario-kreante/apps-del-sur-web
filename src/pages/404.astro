---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contactCTA } from '../data/content';

const title = 'Esta página no existe | Apps del Sur';
const description = 'La dirección que buscas no existe en appsdelsur.cl.';
---

<Layout
  title={title}
  description={description}
  canonical="https://appsdelsur.cl/404"
  ogTitle={title}
  ogDescription={description}
  noindex
  omitFaqSchema
>
  <Header />

  <main id="main-content" class="bg-white">
    <section class="max-w-[640px] mx-auto px-6 py-16 md:py-24 text-center">
      <p class="text-sm text-emerald-700 font-medium mb-3">Error 404</p>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 break-words">Esta página no existe</h1>
      <p class="text-gray-600 mb-8">
        Puede que la dirección esté mal escrita o que la página se haya movido. Estos enlaces te llevan a lo principal.
      </p>

      <ul class="flex flex-col sm:flex-row gap-3 justify-center mb-10">
        <li><a href="/" class="inline-block text-emerald-700 hover:text-emerald-800 font-medium underline">Inicio</a></li>
        <li><a href="/diagnosticos/" class="inline-block text-emerald-700 hover:text-emerald-800 font-medium underline">Diagnósticos</a></li>
        <li><a href="/servicios/" class="inline-block text-emerald-700 hover:text-emerald-800 font-medium underline">Servicios</a></li>
      </ul>

      <p class="text-gray-600 mb-3">¿Necesitas ayuda? Escríbenos.</p>
      <a
        id="contacto-404"
        href={contactCTA.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-6 py-3 rounded-lg"
      >
        {contactCTA.ctaWhatsApp}
      </a>
    </section>
  </main>

  <Footer />
</Layout>
