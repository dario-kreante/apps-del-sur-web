---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogHead from '../../components/blog/BlogHead.astro';
import AuthorAvatar from '../../components/blog/AuthorAvatar.astro';
import { heroComponents } from '../../components/blog-heroes';
import { getCollection } from 'astro:content';
import { blogTopics, topicFor, blogTitle, blogDescription } from '../../lib/blog';
import '../../styles/blog.css';

const posts = (await getCollection('blog')).sort((a,b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const featured = ['calcular-roi-proyecto-ia-pyme-chile', 'cuaderno-de-campo-digital-vinas-chile', 'por-que-fallan-proyectos-ia-pymes'].map(id => posts.find(post => post.id === id)).filter(Boolean);
const formatDate = (date: Date) => date.toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).replace('.', '');
const schema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': 'https://appsdelsur.cl/blog/#collection', url: 'https://appsdelsur.cl/blog/', name: blogTitle, description: blogDescription, inLanguage: 'es-CL', mainEntity: { '@type': 'ItemList', itemListElement: posts.map((post, i) => ({ '@type': 'ListItem', position: i + 1, name: post.data.title, url: `https://appsdelsur.cl/blog/${post.id}/` })) } }).replaceAll('<','\\u003c');
---
<Layout title={blogTitle} description={blogDescription} canonical="https://appsdelsur.cl/blog/" ogTitle={blogTitle} ogDescription={blogDescription} omitFaqSchema>
  <BlogHead slot="head" />
  <script type="application/ld+json" set:html={schema} />
  <Header />

  <main id="main-content" class="blog pt-16">
    <h1 class="sr-only">Blog de Apps del Sur</h1>

    <nav class="blog-tabs" aria-label="Filtrar artículos por tema">
      <div class="max-w-[1100px] mx-auto px-6">
        <div class="blog-tabs__row">
          <a href="/blog/" data-topic="todos" aria-current="true">Todos</a>
          {blogTopics.map(topic => <a href={`/blog/?tema=${topic.id}`} data-topic={topic.id}>{topic.label}</a>)}
        </div>
      </div>
    </nav>

    <div class="max-w-[1100px] mx-auto px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-16">
      <section aria-labelledby="feed-title" class="max-w-[700px]">
        <h2 id="feed-title" class="sr-only">Artículos</h2>
        <form id="blog-search" role="search" class="lg:hidden mt-6">
          <label for="search-mobile" class="sr-only">Buscar en el blog</label>
          <div class="blog-search">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="search-mobile" data-search-input type="search" placeholder="Buscar: costos, WhatsApp, viñas…" autocomplete="off" />
          </div>
        </form>

        <p id="results" class="sr-only" role="status" aria-live="polite">{posts.length} artículos</p>

        <div>
          {posts.map(post => {
            const Hero = heroComponents[post.id];
            const topic = topicFor(post.id);
            const date = post.data.updatedDate ?? post.data.pubDate;
            return (
              <article class="blog-feed-item" data-category={topic.id} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`}>
                <div class="blog-feed-item__byline">
                  <AuthorAvatar name={post.data.author} size="sm" />
                  <strong>{post.data.author}</strong>
                  <span>en {topic.label}</span>
                </div>
                <div>
                  <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
                  <p class="blog-feed-item__summary">{post.data.description}</p>
                  <div class="blog-feed-item__meta">
                    <time datetime={date.toISOString()}>{post.data.updatedDate ? 'Actualizado el ' : ''}{formatDate(date)}</time>
                    <span>{post.data.readingTime} de lectura</span>
                  </div>
                </div>
                {Hero && (
                  <a href={`/blog/${post.id}/`} class="blog-thumb" tabindex="-1" aria-hidden="true">
                    <Hero />
                  </a>
                )}
              </article>
            );
          })}
        </div>

        <div id="empty" class="py-16" hidden>
          <h2 class="text-xl font-bold">No hay artículos con esa búsqueda</h2>
          <p class="mt-2 text-[15px] text-[var(--muted)]">Prueba con otra palabra o vuelve a ver todos los temas.</p>
          <button type="button" id="reset-search" class="mt-5 text-[15px] font-medium text-[var(--brand-deep)] underline underline-offset-4">Ver todos los artículos</button>
        </div>
      </section>

      <aside class="blog-side hidden lg:block pt-10">
        <div class="sticky top-32">
          <section>
            <form role="search" onsubmit="return false">
              <label for="search-desktop" class="sr-only">Buscar en el blog</label>
              <div class="blog-search">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="search-desktop" data-search-input type="search" placeholder="Buscar en el blog" autocomplete="off" />
              </div>
            </form>
          </section>

          <section>
            <h2>Lecturas recomendadas</h2>
            {featured.map(post => post && (
              <div class="blog-side__pick">
                <div class="blog-feed-item__byline">
                  <AuthorAvatar name={post.data.author} size="sm" />
                  <span>{topicFor(post.id).label}</span>
                </div>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </div>
            ))}
          </section>

          <section>
            <h2>Sobre Apps del Sur</h2>
            <p class="text-[15px] leading-relaxed text-[var(--muted)]">
              Consultora boutique de software a medida e IA aplicada, con base en Talca. Escribimos sobre lo que vemos en terreno: costos, procesos y herramientas que sirven a una pyme.
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-4">
              <a href="/#contacto" class="inline-flex items-center rounded-full bg-[var(--brand)] px-5 py-2.5 text-sm font-medium text-white hover:bg-[var(--brand-deep)] transition-colors">Conversemos</a>
              <a href="/nosotros/" class="text-sm font-medium text-[var(--brand-deep)] underline underline-offset-4">Quiénes somos</a>
            </div>
          </section>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const normalize = (value: string) => value.normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase();
  const inputs = [...document.querySelectorAll<HTMLInputElement>('[data-search-input]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.blog-feed-item')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-topic]')];
  let topic = 'todos';
  let query = '';
  const apply = () => {
    let count = 0;
    for (const card of cards) {
      card.hidden = !((topic === 'todos' || card.dataset.category === topic) && normalize(card.dataset.search ?? '').includes(normalize(query.trim())));
      if (!card.hidden) count++;
    }
    links.forEach(link => link.setAttribute('aria-current', String(link.dataset.topic === topic)));
    document.querySelector('#results')!.textContent = `${count} ${count === 1 ? 'artículo' : 'artículos'}`;
    (document.querySelector('#empty') as HTMLElement).hidden = count > 0;
    const url = new URL(location.href);
    topic === 'todos' ? url.searchParams.delete('tema') : url.searchParams.set('tema', topic);
    query.trim() ? url.searchParams.set('q', query.trim()) : url.searchParams.delete('q');
    history.replaceState(null, '', url);
  };
  const params = new URLSearchParams(location.search);
  if (links.some(link => link.dataset.topic === params.get('tema'))) topic = params.get('tema')!;
  query = params.get('q') ?? '';
  inputs.forEach(input => { input.value = query; });
  apply();
  links.forEach(link => link.addEventListener('click', event => { event.preventDefault(); topic = link.dataset.topic!; apply(); }));
  inputs.forEach(input => input.addEventListener('input', () => {
    query = input.value;
    inputs.forEach(other => { if (other !== input) other.value = query; });
    apply();
  }));
  document.querySelector('#blog-search')!.addEventListener('submit', event => { event.preventDefault(); apply(); });
  document.querySelector('#reset-search')!.addEventListener('click', () => {
    topic = 'todos'; query = '';
    inputs.forEach(input => { input.value = ''; });
    apply();
    inputs.find(input => input.offsetParent !== null)?.focus();
  });
</script>
