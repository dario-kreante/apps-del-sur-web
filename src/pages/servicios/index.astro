---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ContactForm from '../../components/ContactForm.astro';
import Button from '../../components/ui/Button.astro';
import ArrowRight from '../../components/icons/ArrowRight.astro';
import { nosotrosPage } from '../../data/content';

const title = 'Servicios de software a medida, agentes IA y consultoría para pymes';
const description = 'Software a medida, agentes de IA por WhatsApp, integraciones, diagnósticos, consultoría y postulación a fondos públicos para pymes del centro-sur de Chile.';
const canonical = 'https://appsdelsur.cl/servicios/';

const situations = [
  { problem: 'Seguimos con papel, planillas o sistemas que no se conectan', service: 'Software a medida', href: '/enfoque/' },
  { problem: 'No damos abasto con las consultas por WhatsApp', service: 'Agentes IA', href: '/agentes/' },
  { problem: 'La IA está en la mesa, pero no tenemos un plan', service: 'Workshop Brújula IA', href: '/servicios/workshop-brujula-ia/' },
  { problem: 'No sabemos cómo estamos frente a la Ley 21.719', service: 'Diagnóstico de datos personales', href: '/servicios/diagnostico-datos-personales/' },
  { problem: 'Queremos postular a un fondo público', service: 'Sprint de postulación', href: '/servicios/sprint-diagnostico-postulacion-fondos/' },
  { problem: 'Tenemos el plan, pero nos falta quién lo ejecute', service: 'Copiloto Estratégico', href: '/servicios/acompanamiento-copiloto-estrategico/' },
];

const stages = [
  {
    id: 'entender',
    verb: 'Entender',
    summary: 'Saber cómo está su empresa antes de invertir',
    services: [
      {
        name: 'Diagnósticos gratuitos',
        description: 'Madurez digital, madurez en IA y datos personales. Responde en línea y recibe su resultado al terminar.',
        meta: 'Gratis · Unos 8 minutos',
        href: '/diagnosticos/',
        cta: 'Elegir un diagnóstico',
      },
      {
        name: 'Diagnóstico técnico de datos personales',
        description: 'Revisamos sistemas, planillas y proveedores. Recibe un mapa de sus datos y un plan priorizado frente a la Ley 21.719.',
        meta: 'Según tamaño y procesos a revisar',
        href: '/servicios/diagnostico-datos-personales/',
        cta: 'Ver el diagnóstico',
      },
    ],
  },
  {
    id: 'decidir',
    verb: 'Decidir',
    summary: 'Definir qué conviene hacer primero y qué no vale la pena',
    services: [
      {
        name: 'Workshop Brújula IA',
        description: 'Su equipo directivo trabaja sobre su propia empresa y sale con una matriz de madurez, 3 mejoras rápidas y un plan de 90 días.',
        meta: '1 día · 4 a 12 personas',
        href: '/servicios/workshop-brujula-ia/',
        cta: 'Ver el workshop',
      },
    ],
  },
  {
    id: 'construir',
    verb: 'Construir',
    summary: 'Convertir la decisión en un sistema que su equipo use a diario',
    note: 'Cada implementación incluye un taller práctico de IA y 3 meses de Claude Pro para cada participante.',
    services: [
      {
        name: 'Software a medida',
        description: 'Sistemas web y apps móviles construidos alrededor de su proceso, con modo offline cuando la operación lo requiere.',
        meta: '8 a 12 semanas',
        href: '/enfoque/',
        cta: 'Ver cómo trabajamos',
      },
      {
        name: 'Agentes IA por WhatsApp',
        description: 'Agendan, responden consultas, califican contactos y hacen seguimiento, según lo que necesite su rubro.',
        meta: '2 a 6 semanas',
        href: '/agentes/',
        cta: 'Ver los agentes',
      },
      {
        name: 'Automatización e integraciones',
        description: 'Reducimos la doble digitación y conectamos su ERP, contabilidad, RRHH o planillas, sin obligarlo a partir desde cero.',
        meta: 'Según alcance',
        href: '#contact-form',
        cta: 'Contarnos su caso',
      },
    ],
  },
  {
    id: 'financiar',
    verb: 'Financiar',
    summary: 'Buscar cofinanciamiento público cuando el proyecto lo permite',
    services: [
      {
        name: 'Sprint Diagnóstico + Postulación a Fondo',
        description: 'Construimos el caso de negocio en pesos, elegimos el fondo que aplica y dejamos la postulación entregada. La adjudicación no está garantizada.',
        meta: '4 a 6 semanas · Parte del pago al adjudicarse',
        href: '/servicios/sprint-diagnostico-postulacion-fondos/',
        cta: 'Ver el sprint',
      },
    ],
  },
  {
    id: 'evolucionar',
    verb: 'Evolucionar',
    summary: 'Sostener lo construido y seguir avanzando',
    services: [
      {
        name: 'Copiloto Estratégico',
        description: 'Ejecutamos el plan junto a su equipo: proveedores, gestión del cambio, capacitación y medición trimestral de resultados.',
        meta: '6, 9 o 12 meses',
        href: '/servicios/acompanamiento-copiloto-estrategico/',
        cta: 'Ver el copiloto',
      },
      {
        name: 'Soporte y mejora continua',
        description: 'Mantención, ajustes y nuevos módulos o reportes para el sistema que ya tiene funcionando.',
        meta: 'Según alcance',
        href: '#contact-form',
        cta: 'Consultar soporte',
      },
    ],
  },
];

const investmentSteps = [
  { title: 'Conversación inicial', description: 'Sin costo. Entendemos su operación y le decimos si podemos ayudarle.' },
  { title: 'Diagnóstico', description: 'Revisamos alcance, integraciones y tamaño del equipo.' },
  { title: 'Propuesta cerrada', description: 'Con inversión, plazos y los fondos públicos que podrían aplicar.' },
];

const costGuides = [
  { label: 'Software a medida', href: '/blog/cuanto-cuesta-software-a-medida-chile/' },
  { label: 'Automatizar WhatsApp', href: '/blog/cuanto-cuesta-automatizar-whatsapp-empresa/' },
  { label: 'Implementar IA en una pyme', href: '/blog/cuanto-cuesta-implementar-ia-pyme-chile/' },
];

const needOptions = stages.flatMap((stage) => stage.services.map((service) => service.name));

const { projects } = nosotrosPage;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios Apps del Sur',
  description,
  itemListElement: stages
    .flatMap((stage) => stage.services)
    .map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.name,
        description: service.description,
        provider: { '@type': 'Organization', name: 'Apps del Sur', url: 'https://appsdelsur.cl' },
        areaServed: { '@type': 'Country', name: 'Chile' },
        url: service.href.startsWith('#') ? `${canonical}${service.href}` : `https://appsdelsur.cl${service.href}`,
      },
    })),
});
---

<Layout title={`${title} | Apps del Sur`} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={jsonLd} />
  <Header />

  <main id="main-content" class="pt-24">
    <div class="max-w-[1100px] mx-auto px-6">
      <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="text-emerald-700 hover:text-emerald-800">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-gray-500">Servicios</span>
      </nav>

      <header class="max-w-3xl mb-14">
        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 leading-tight tracking-tight mb-4">Del problema en su operación al sistema funcionando</h1>
        <p class="text-lg text-gray-600 leading-relaxed">Diagnosticamos, definimos con usted qué conviene hacer y lo construimos: software a medida, agentes de IA por WhatsApp e integraciones con lo que ya usa. Puede entrar por la etapa que necesite.</p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 mt-6">
          <Button href="#contact-form" size="lg">Conversemos</Button>
          <Button href="/diagnosticos/" variant="outline" size="lg">Hacer un diagnóstico gratuito</Button>
        </div>
        <p class="mt-4 text-sm text-gray-500">Conversación inicial sin costo · Pocos proyectos en paralelo</p>
      </header>

      <section aria-labelledby="situaciones" class="mb-20">
        <h2 id="situaciones" class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight mb-6">¿Qué le está pasando hoy?</h2>
        <ul class="grid md:grid-cols-2 gap-3">
          {situations.map((situation) => (
            <li>
              <a href={situation.href} class="group flex h-full items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white p-4 transition-colors hover:border-emerald-500 hover:bg-emerald-50/50">
                <span>
                  <span class="block font-medium text-gray-900">{situation.problem}</span>
                  <span class="block mt-1 text-sm text-emerald-700">{situation.service}</span>
                </span>
                <ArrowRight class="w-5 h-5 shrink-0 text-gray-400 transition-colors group-hover:text-emerald-700" />
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="oferta" class="mb-20">
        <h2 id="oferta" class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight mb-2">Todo lo que hacemos</h2>
        <p class="text-gray-600 mb-8">No necesita recorrer todas las etapas: cada servicio sirve por sí solo</p>

        <div class="divide-y divide-gray-200 border-y border-gray-200">
          {stages.map((stage, index) => (
            <section id={stage.id} aria-labelledby={`${stage.id}-titulo`} class="grid lg:grid-cols-[230px_1fr] gap-5 lg:gap-8 py-8 scroll-mt-24">
              <div>
                <p class="text-sm font-medium text-emerald-700 mb-1">{String(index + 1).padStart(2, '0')}</p>
                <h3 id={`${stage.id}-titulo`} class="text-xl font-bold text-gray-900 mb-1">{stage.verb}</h3>
                <p class="text-sm text-gray-600 leading-relaxed">{stage.summary}</p>
              </div>
              <div>
                <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
                  {stage.services.map((service) => (
                    <article class="flex flex-col rounded-xl border border-gray-200 bg-white p-5">
                      <h4 class="font-semibold text-gray-900 mb-2">{service.name}</h4>
                      <p class="text-sm text-gray-600 leading-relaxed mb-4">{service.description}</p>
                      <p class="mt-auto text-xs text-gray-500 mb-3">{service.meta}</p>
                      <a href={service.href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:text-emerald-800">
                        {service.cta}
                        <ArrowRight class="w-4 h-4" />
                      </a>
                    </article>
                  ))}
                </div>
                {stage.note && <p class="mt-4 text-sm text-gray-600">{stage.note}</p>}
              </div>
            </section>
          ))}
        </div>
      </section>

      <section aria-labelledby="proyectos" class="mb-20">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
          <h2 id="proyectos" class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight">{projects.title}</h2>
          <a href="/nosotros/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:text-emerald-800 shrink-0">
            Conocer al equipo
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {projects.items.map((project) => (
            <li class="rounded-xl bg-gray-50 border border-gray-100 p-5">
              <p class="text-xs font-medium text-emerald-700 mb-2">{'status' in project ? `${project.tag} · ${project.status}` : project.tag}</p>
              <p class="font-semibold text-gray-900 mb-1">{project.title}</p>
              <p class="text-sm text-gray-600">{project.client}</p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="inversion" class="mb-20">
        <h2 id="inversion" class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight mb-6">Cómo se define la inversión</h2>
        <ol class="grid md:grid-cols-3 gap-4 mb-6">
          {investmentSteps.map((step, index) => (
            <li class="rounded-xl border border-gray-200 p-5">
              <p class="text-sm font-medium text-emerald-700 mb-1">Paso {index + 1}</p>
              <p class="font-semibold text-gray-900 mb-1">{step.title}</p>
              <p class="text-sm text-gray-600 leading-relaxed">{step.description}</p>
            </li>
          ))}
        </ol>
        <p class="text-sm text-gray-600">
          ¿Quiere una referencia antes de conversar? Revise cuánto cuesta:
          {costGuides.map((guide, index) => (
            <>
              {index > 0 && ' · '}
              <a href={guide.href} class="font-medium text-emerald-700 underline underline-offset-2 hover:text-emerald-800">{guide.label}</a>
            </>
          ))}
        </p>
      </section>
    </div>
  </main>

  <ContactCTA
    title="Cuéntenos qué necesita resolver"
    description="Revisamos su situación y le decimos por dónde partir, incluso si la recomendación es no construir nada todavía."
  />
  <ContactForm
    title="Conversemos sobre su empresa"
    description="Cuéntenos qué quiere resolver y qué herramientas usa hoy. Le contactaremos en menos de 24 horas."
    needOptions={needOptions}
  />
  <Footer />
</Layout>
