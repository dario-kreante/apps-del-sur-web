---
import AdminLayout from '../../layouts/AdminLayout.astro';
import LeadCard from '../../components/admin/LeadCard.astro';
import {
  F,
  TABLES,
  airtableToken,
  attachmentUrl,
  listAll,
  selectName,
} from '../../lib/admin/airtable';
import { canalSugerido, mailtoLink, waLink, type Canal } from '../../lib/admin/canales';

export const prerender = false;

const token = airtableToken(import.meta.env);

let error: string | null = null;
let registros: Awaited<ReturnType<typeof listAll>> = [];

if (!token) {
  error = 'Falta el token de Airtable (AIRTABLE_TOKEN o AIRTABLE_API_KEY).';
} else {
  try {
    registros = await listAll(token, TABLES.leads);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Error consultando Airtable.';
  }
}

const str = (r: any, f: string) => String(r.fields[f] ?? '');

const leads = registros.map((r) => {
  const email = str(r, F.lead.email);
  const telefono = str(r, F.lead.telefono);
  const borrador = str(r, F.lead.borrador);
  const canal = canalSugerido({ email, telefono });
  return {
    id: r.id,
    empresa: str(r, F.lead.empresa),
    rubro: selectName(r.fields[F.lead.rubro]),
    region: selectName(r.fields[F.lead.region]),
    etapa: selectName(r.fields[F.lead.etapa]),
    contacto: str(r, F.lead.contacto),
    cargo: str(r, F.lead.cargo),
    email,
    telefono,
    angulo: str(r, F.lead.valorAporte),
    borrador,
    toques: Number(r.fields[F.lead.toques] ?? 0),
    respondio: Boolean(r.fields[F.lead.respondio]),
    control: selectName(r.fields[F.lead.control]),
    proximaAccion: str(r, F.lead.proximaAccion),
    dossier: str(r, F.lead.dossier),
    mockupUrl: attachmentUrl(r.fields[F.lead.mockup]),
    fechaUltimoContacto: str(r, F.lead.fechaUltimoContacto),
    canal,
    waHref: waLink(telefono, borrador),
    mailHref: mailtoLink(email, borrador),
  };
});

const ETAPAS_CERRADAS = new Set([
  'Cerrado Ganado',
  'Cerrado Perdido',
  'Descartado',
]);
const abiertos = leads.filter((l) => !ETAPAS_CERRADAS.has(l.etapa));

const contactados = abiertos.filter((l) => l.toques > 0);
const respondieron = abiertos.filter((l) => l.respondio);
const tasa = contactados.length
  ? Math.round((respondieron.length / contactados.length) * 100)
  : null;

const automatizables = abiertos.filter((l) => l.canal === 'email');
const manuales = abiertos.filter((l) => l.canal !== 'email');
const porcManual = abiertos.length
  ? Math.round((manuales.length / abiertos.length) * 100)
  : 0;

/** Un lead con toques pero sin movimiento hace más de 14 días se está muriendo. */
const HOY = new Date();
const rancios = abiertos.filter((l) => {
  if (l.toques === 0 || !l.fechaUltimoContacto) return false;
  const dias =
    (HOY.getTime() - new Date(l.fechaUltimoContacto).getTime()) / 86_400_000;
  return dias > 14;
});

// El experimento: qué rubro responde. Sin denominador el porcentaje miente.
const rubros = [...new Set(abiertos.map((l) => l.rubro).filter(Boolean))]
  .map((rubro) => {
    const enRubro = abiertos.filter((l) => l.rubro === rubro);
    const cont = enRubro.filter((l) => l.toques > 0).length;
    const resp = enRubro.filter((l) => l.respondio).length;
    return {
      rubro,
      total: enRubro.length,
      contactados: cont,
      respondieron: resp,
      tasa: cont ? Math.round((resp / cont) * 100) : null,
    };
  })
  .sort((a, b) => b.total - a.total);

const grupos: { canal: Canal; titulo: string; nota: string; items: typeof abiertos }[] = [
  {
    canal: 'email',
    titulo: 'Correo',
    nota: 'Ciclo completo automatizable: se redacta, se envía y se lee la respuesta sin intervención.',
    items: abiertos.filter((l) => l.canal === 'email'),
  },
  {
    canal: 'whatsapp',
    titulo: 'WhatsApp',
    nota: 'El link abre la conversación con el texto escrito. El mockup se adjunta a mano.',
    items: abiertos.filter((l) => l.canal === 'whatsapp'),
  },
  {
    canal: 'llamada',
    titulo: 'Teléfono',
    nota: 'Fijo sin WhatsApp. La llamada es la única vía, y también es como se consigue el nombre.',
    items: abiertos.filter((l) => l.canal === 'llamada'),
  },
  {
    canal: 'manual',
    titulo: 'Sin canal',
    nota: 'Falta el dato de contacto. No se puede trabajar hasta resolverlo.',
    items: abiertos.filter((l) => l.canal === 'manual'),
  },
].filter((g) => g.items.length > 0);

const aviso = Astro.url.searchParams.get('ok');
---

<AdminLayout title="Pipeline" activo="pipeline">
  {error && (
    <div role="alert" class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4">
      <p class="text-sm font-medium text-red-900">No se pudo cargar el pipeline</p>
      <p class="mt-1 text-sm text-red-800">{error}</p>
    </div>
  )}

  {aviso && (
    <p class="mb-6 rounded-lg bg-emerald-50 px-4 py-2.5 text-sm text-emerald-900">
      {decodeURIComponent(aviso)}
    </p>
  )}

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-gray-900">Pipeline</h1>
      <p class="mt-1 text-sm text-gray-600">
        {abiertos.length} leads abiertos · {leads.length - abiertos.length} cerrados
      </p>
    </div>
  </div>

  <section class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {[
      { label: 'Contactados', valor: String(contactados.length), pie: `de ${abiertos.length} abiertos` },
      { label: 'Respondieron', valor: String(respondieron.length), pie: tasa === null ? 'sin envíos aún' : `${tasa}% de los contactados` },
      { label: 'Automatizables', valor: String(automatizables.length), pie: 'alcanzables por correo' },
      { label: 'Cola manual', valor: String(manuales.length), pie: `${porcManual}% del pipeline` },
    ].map((t) => (
      <div class="rounded-xl border border-gray-200 bg-white p-4">
        <p class="text-xs font-medium uppercase tracking-wider text-gray-500">{t.label}</p>
        <p class="mt-1 text-2xl font-semibold tabular-nums text-gray-900">{t.valor}</p>
        <p class="mt-0.5 text-xs text-gray-500">{t.pie}</p>
      </div>
    ))}
  </section>

  {porcManual > 33 && abiertos.length > 0 && (
    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4">
      <p class="text-sm font-medium text-amber-900">
        El {porcManual}% del pipeline depende de un canal manual
      </p>
      <p class="mt-1 text-sm text-amber-800">
        Sobre un tercio, el pipeline avanza al ritmo de una persona con tiempo para
        llamar, no al de un agente. Al abrir el próximo rubro, apuntar a empresas
        con correo nominal obtenible.
      </p>
    </div>
  )}

  {rancios.length > 0 && (
    <div class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4">
      <p class="text-sm font-medium text-red-900">
        {rancios.length} {rancios.length === 1 ? 'lead lleva' : 'leads llevan'} más de 14 días sin toque
      </p>
      <p class="mt-1 text-sm text-red-800">
        {rancios.map((l) => l.empresa).join(' · ')} — cerrar o dar el siguiente toque.
      </p>
    </div>
  )}

  {rubros.length > 0 && (
    <section class="mt-8">
      <h2 class="text-sm font-semibold tracking-tight text-gray-900">
        El experimento: qué rubro responde
      </h2>
      <p class="mt-1 text-sm text-gray-600">
        Ningún rubro con menos de 8 contactados dice nada todavía. El conteo crudo
        va al lado del porcentaje justamente para no confundirse.
      </p>
      <div class="mt-3 overflow-x-auto rounded-xl border border-gray-200 bg-white">
        <table class="w-full text-sm">
          <thead class="border-b border-gray-200 bg-gray-50 text-left">
            <tr class="text-xs font-medium uppercase tracking-wider text-gray-500">
              <th class="px-4 py-2.5">Rubro</th>
              <th class="px-4 py-2.5 text-right">Leads</th>
              <th class="px-4 py-2.5 text-right">Contactados</th>
              <th class="px-4 py-2.5 text-right">Respondieron</th>
              <th class="px-4 py-2.5 text-right">Tasa</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {rubros.map((r) => (
              <tr>
                <td class="px-4 py-2.5 font-medium text-gray-900">{r.rubro}</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-gray-700">{r.total}</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-gray-700">{r.contactados}</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-gray-700">{r.respondieron}</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-gray-500">
                  {r.contactados < 8 ? (
                    <span class="text-gray-400">sin datos</span>
                  ) : (
                    `${r.tasa}%`
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {grupos.map((g) => (
    <section class="mt-10">
      <div class="flex items-baseline gap-3">
        <h2 class="text-sm font-semibold tracking-tight text-gray-900">{g.titulo}</h2>
        <span class="text-xs tabular-nums text-gray-500">{g.items.length}</span>
      </div>
      <p class="mt-1 max-w-2xl text-sm text-gray-600">{g.nota}</p>
      <div class="mt-4 grid gap-4 xl:grid-cols-2">
        {g.items.map((l) => <LeadCard {...l} />)}
      </div>
    </section>
  ))}

  {!error && abiertos.length === 0 && (
    <p class="mt-10 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-sm text-gray-500">
      No hay leads abiertos.
    </p>
  )}
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('[data-lead-card]');
      const texto = card?.querySelector('[data-mensaje]')?.textContent ?? '';
      if (!texto) return;
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(texto.trim());
        btn.textContent = 'Copiado';
      } catch {
        btn.textContent = 'No se pudo copiar';
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 1800);
    });
  });
</script>
