---
import AdminLayout from '../../layouts/AdminLayout.astro';
import LeadRow from '../../components/admin/LeadRow.astro';
import {
  F, TABLES, airtableToken, attachmentUrl, listAll, selectName,
} from '../../lib/admin/airtable';
import { serverEnv } from '../../lib/admin/env';
import { canalSugerido, gmailLink, waLink } from '../../lib/admin/canales';
import { SEGMENTOS, evaluar, type SegmentoId } from '../../lib/admin/prioridad';

export const prerender = false;

const token = airtableToken(serverEnv());

let error: string | null = null;
let registros: Awaited<ReturnType<typeof listAll>> = [];

if (!token) {
  error = 'Falta el token de Airtable (AIRTABLE_TOKEN o AIRTABLE_API_KEY).';
} else {
  try {
    registros = await listAll(token, TABLES.leads);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Error consultando Airtable.';
  }
}

const str = (r: any, f: string) => String(r.fields[f] ?? '');

const CERRADAS = new Set(['Cerrado Ganado', 'Cerrado Perdido', 'Descartado']);

const leads = registros
  .map((r) => {
    const email = str(r, F.lead.email);
    const telefono = str(r, F.lead.telefono);
    const borrador = str(r, F.lead.borrador);
    const respondio = Boolean(r.fields[F.lead.respondio]);
    const base = {
      id: r.id,
      empresa: str(r, F.lead.empresa),
      rubro: selectName(r.fields[F.lead.rubro]),
      region: selectName(r.fields[F.lead.region]),
      comuna: str(r, F.lead.comuna),
      etapa: selectName(r.fields[F.lead.etapa]),
      contacto: str(r, F.lead.contacto),
      email,
      telefono,
      angulo: str(r, F.lead.valorAporte),
      borrador,
      toques: Number(r.fields[F.lead.toques] ?? 0),
      respondio,
      control: selectName(r.fields[F.lead.control]),
      proximaAccion: str(r, F.lead.proximaAccion),
      dossier: str(r, F.lead.dossier),
      mockupUrl: attachmentUrl(r.fields[F.lead.mockup]),
      fechaUltimoContacto: str(r, F.lead.fechaUltimoContacto),
      fechaProximaAccion: str(r, F.lead.fechaProximaAccion),
      canal: canalSugerido({ email, telefono, respondio }),
    };
    return {
      ...base,
      waHref: waLink(telefono, borrador),
      mailHref: gmailLink(email, borrador),
      senal: evaluar(base),
    };
  })
  .filter((l) => !CERRADAS.has(l.etapa))
  .sort((a, b) => a.senal.orden - b.senal.orden || a.empresa.localeCompare(b.empresa));

const conteos = Object.fromEntries(
  SEGMENTOS.map((s) => [s.id, leads.filter((l) => s.incluye(l.senal)).length]),
) as Record<SegmentoId, number>;

// Si no hay nada urgente, arrancar en "Todos" evita una pantalla vacía sin sentido.
const pedido = Astro.url.searchParams.get('ver') as SegmentoId | null;
const activo: SegmentoId =
  pedido && SEGMENTOS.some((s) => s.id === pedido)
    ? pedido
    : conteos.ahora > 0
      ? 'ahora'
      : 'todos';

const segmento = SEGMENTOS.find((s) => s.id === activo)!;

// El hero solo tiene sentido si de verdad hay algo que hacer.
const destacado =
  conteos.ahora > 0 && activo === 'ahora'
    ? (leads.find((l) => SEGMENTOS[0].incluye(l.senal)) ?? null)
    : null;

/**
 * Se renderizan TODOS los leads, no solo los del segmento activo.
 *
 * Buscar a alguien y no encontrarlo porque estaba en otra pestana es
 * exactamente el fracaso que una busqueda tiene que evitar, asi que el filtro
 * de texto ignora el segmento; y para eso las filas tienen que estar en el
 * DOM. Las que no corresponden al segmento nacen ocultas, de modo que el
 * filtro por segmento siga funcionando aunque no cargue el JavaScript.
 */
const sinAcentos = (t: string) =>
  t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

const filas = leads
  .filter((l) => l !== destacado)
  .map((l) => ({
    ...l,
    oculta: !segmento.incluye(l.senal),
    segmentos: SEGMENTOS.filter((s) => s.incluye(l.senal))
      .map((s) => s.id)
      .join(' '),
    busqueda: sinAcentos(
      [
        l.empresa, l.contacto, l.rubro, l.region, l.comuna,
        l.etapa, l.email, l.telefono, l.senal.etiqueta,
      ]
        .filter(Boolean)
        .join(' '),
    ),
  }));

const manuales = leads.filter((l) => l.canal !== 'email').length;
const porcManual = leads.length ? Math.round((manuales / leads.length) * 100) : 0;

const rubros = [...new Set(leads.map((l) => l.rubro).filter(Boolean))]
  .map((rubro) => {
    const en = leads.filter((l) => l.rubro === rubro);
    const cont = en.filter((l) => l.toques > 0).length;
    const resp = en.filter((l) => l.respondio).length;
    return { rubro, total: en.length, contactados: cont, respondieron: resp,
             tasa: cont ? Math.round((resp / cont) * 100) : null };
  })
  .sort((a, b) => b.total - a.total);

const contactados = leads.filter((l) => l.toques > 0).length;
const aviso = Astro.url.searchParams.get('ok');
---

<AdminLayout title="Pipeline" activo="pipeline">
  {error && (
    <div role="alert" class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4">
      <p class="text-sm font-medium text-red-900">No se pudo cargar el pipeline</p>
      <p class="mt-1 text-sm text-red-800">{error}</p>
    </div>
  )}

  {aviso && (
    <p class="mb-6 rounded-lg bg-emerald-50 px-4 py-2.5 text-sm text-emerald-900">
      {decodeURIComponent(aviso)}
    </p>
  )}

  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h1 class="text-2xl font-semibold tracking-tight text-gray-900">Pipeline</h1>
    <p class="text-sm text-gray-500 tabular-nums">
      {leads.length} abiertos · {contactados} contactados
    </p>
  </div>

  <!-- Lo que toca ahora: un nombre, no una lista -->
  {destacado && (
    <section data-hero class="mt-5 overflow-hidden rounded-xl border border-emerald-200 bg-white shadow-sm">
      <div class="border-b border-emerald-100 bg-emerald-50/70 px-5 py-2">
        <p class="text-[11px] font-semibold tracking-wider text-emerald-800 uppercase">
          Lo primero
        </p>
      </div>
      <div class="px-5 py-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-lg font-semibold tracking-tight text-gray-900">
            {destacado.empresa}
          </h2>
          <span class="text-sm text-gray-500">
            {destacado.contacto || 'sin contacto nominal'}
          </span>
        </div>
        <p class="mt-1 text-sm text-gray-700">{destacado.senal.motivo}</p>

        {destacado.borrador.trim() && (
          <p class="mt-3 line-clamp-3 border-l-2 border-gray-200 pl-3 text-sm leading-relaxed text-gray-600">
            {destacado.borrador.trim().split('\n').filter(Boolean).slice(0, 2).join(' ')}
          </p>
        )}

        <div class="mt-4 flex flex-wrap items-center gap-2">
          {destacado.canal === 'email' && destacado.mailHref && (
            <a href={destacado.mailHref} target="_blank" rel="noopener noreferrer"
              class="inline-flex min-h-9 items-center rounded-lg bg-emerald-700 px-4 text-sm font-medium text-white transition-colors hover:bg-emerald-800">
              Abrir en Gmail
            </a>
          )}
          {destacado.canal === 'whatsapp' && destacado.waHref && (
            <a href={destacado.waHref} target="_blank" rel="noopener noreferrer"
              class="inline-flex min-h-9 items-center rounded-lg bg-emerald-700 px-4 text-sm font-medium text-white transition-colors hover:bg-emerald-800">
              Abrir WhatsApp
            </a>
          )}
          {destacado.canal === 'llamada' && destacado.telefono && (
            <a href={`tel:${destacado.telefono.replace(/\s/g, '')}`}
              class="inline-flex min-h-9 items-center rounded-lg bg-orange-600 px-4 text-sm font-medium text-white transition-colors hover:bg-orange-700">
              Llamar a {destacado.telefono}
            </a>
          )}
          <a href="#lista" class="inline-flex min-h-9 items-center px-2 text-sm text-gray-500 transition-colors hover:text-gray-900">
            Ver el detalle abajo
          </a>
        </div>
      </div>
    </section>
  )}

  <div class="mt-6 flex flex-wrap items-center gap-3">
  <!-- Los segmentos filtran y a la vez son el resumen: un solo lugar que leer -->
  <nav class="flex flex-wrap gap-1.5" aria-label="Filtros">
    {SEGMENTOS.map((s) => (
      <a
        href={`?ver=${s.id}`}
        aria-current={activo === s.id ? 'page' : undefined}
        class:list={[
          'inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors',
          activo === s.id
            ? 'border-gray-900 bg-gray-900 text-white'
            : 'border-gray-200 bg-white text-gray-700 hover:bg-gray-50',
        ]}
      >
        {s.label}
        <span class:list={[
          'tabular-nums',
          activo === s.id ? 'text-gray-400' : 'text-gray-400',
        ]}>{conteos[s.id]}</span>
      </a>
    ))}
  </nav>

    <div class="relative ml-auto min-w-52 flex-1 sm:max-w-xs sm:flex-none">
      <svg
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
      </svg>
      <input
        type="search"
        id="buscador"
        placeholder="Buscar empresa, persona, rubro..."
        autocomplete="off"
        aria-label="Buscar en todo el pipeline"
        class="w-full rounded-lg border border-gray-200 bg-white py-1.5 pr-16 pl-9 text-sm text-gray-900 placeholder:text-gray-400 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 focus:outline-none"
      />
      <kbd
        data-atajo
        class="pointer-events-none absolute top-1/2 right-2.5 -translate-y-1/2 rounded border border-gray-200 bg-gray-50 px-1.5 py-0.5 font-mono text-[10px] text-gray-400"
        >/</kbd
      >
    </div>
  </div>

  <p data-resultados class="mt-3 hidden text-sm text-gray-600"></p>

  <section id="lista" class="mt-4 rounded-xl border border-gray-200 bg-white px-4 shadow-sm">
    {filas.map((l) => <LeadRow {...l} />)}
    <p data-vacio class="hidden py-10 text-center text-sm text-gray-500"></p>
    {filas.length === 0 && (
      <p class="py-10 text-center text-sm text-gray-500">No hay leads abiertos.</p>
    )}
  </section>

  {porcManual > 33 && leads.length > 0 && (
    <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <span class="font-medium">El {porcManual}% del pipeline depende de un canal manual.</span>{' '}
      Pasado un tercio, deja de avanzar al ritmo de un agente y pasa al de una persona
      con tiempo para llamar. Al abrir el próximo rubro, apuntar a empresas con correo
      nominal obtenible.
    </p>
  )}

  <details class="mt-4 rounded-xl border border-gray-200 bg-white px-4 py-3">
    <summary class="cursor-pointer list-none text-sm font-medium text-gray-900">
      El experimento: qué rubro responde
      <span class="ml-1 text-xs font-normal text-gray-500">
        · {contactados} contactados de {leads.length}
      </span>
    </summary>
    <p class="mt-2 text-sm text-gray-600">
      Ningún rubro con menos de 8 contactados dice nada todavía. El conteo crudo va al
      lado del porcentaje justamente para no confundirse.
    </p>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-200 text-left">
          <tr class="text-xs font-medium tracking-wider text-gray-500 uppercase">
            <th class="py-2 pr-4">Rubro</th>
            <th class="py-2 pr-4 text-right">Leads</th>
            <th class="py-2 pr-4 text-right">Contactados</th>
            <th class="py-2 pr-4 text-right">Respondieron</th>
            <th class="py-2 text-right">Tasa</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {rubros.map((r) => (
            <tr>
              <td class="py-2 pr-4 font-medium text-gray-900">{r.rubro}</td>
              <td class="py-2 pr-4 text-right tabular-nums text-gray-700">{r.total}</td>
              <td class="py-2 pr-4 text-right tabular-nums text-gray-700">{r.contactados}</td>
              <td class="py-2 pr-4 text-right tabular-nums text-gray-700">{r.respondieron}</td>
              <td class="py-2 text-right tabular-nums text-gray-500">
                {r.contactados < 8 ? <span class="text-gray-400">sin datos</span> : `${r.tasa}%`}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</AdminLayout>

<script>
  const filas = Array.from(document.querySelectorAll<HTMLElement>('[data-lead]'));
  const buscador = document.querySelector<HTMLInputElement>('#buscador');
  const resultados = document.querySelector<HTMLElement>('[data-resultados]');
  const vacio = document.querySelector<HTMLElement>('[data-vacio]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav a[href^="?ver="]'));

  const sinAcentos = (t: string) =>
    t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  let segmento =
    new URLSearchParams(location.search).get('ver') ?? tabs.find((t) => t.getAttribute('aria-current'))?.href.split('=')[1] ?? 'todos';

  function aplicar() {
    const q = sinAcentos(buscador?.value.trim() ?? '');
    let visibles = 0;

    for (const fila of filas) {
      // Buscar ignora el segmento a propósito: si sé a quién busco, no me
      // importa en qué pestaña quedó clasificado.
      const coincide = q
        ? (fila.dataset.buscar ?? '').includes(q)
        : (fila.dataset.segmentos ?? '').split(' ').includes(segmento);
      fila.classList.toggle('hidden', !coincide);
      if (coincide) visibles++;
      // Una fila abierta que se oculta y vuelve deja la lista desprolija.
      if (!coincide) fila.removeAttribute('open');
    }

    hero?.classList.toggle('hidden', q.length > 0);

    if (resultados) {
      resultados.classList.toggle('hidden', q.length === 0);
      resultados.textContent =
        visibles === 1
          ? '1 lead encontrado, en todo el pipeline.'
          : `${visibles} leads encontrados, en todo el pipeline.`;
    }

    if (vacio) {
      const nada = visibles === 0 && filas.length > 0;
      vacio.classList.toggle('hidden', !nada);
      vacio.textContent = q
        ? `Ningún lead coincide con "${buscador?.value.trim()}".`
        : 'Nada en este segmento.';
    }
  }

  buscador?.addEventListener('input', aplicar);

  for (const tab of tabs) {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      segmento = new URL(tab.href).searchParams.get('ver') ?? 'todos';
      for (const t of tabs) {
        const activo = t === tab;
        t.toggleAttribute('aria-current', activo);
        t.className = activo
          ? 'inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors border-gray-900 bg-gray-900 text-white'
          : 'inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors border-gray-200 bg-white text-gray-700 hover:bg-gray-50';
      }
      if (buscador) buscador.value = '';
      history.replaceState(null, '', tab.href);
      aplicar();
    });
  }

  // "/" para buscar sin sacar las manos del teclado; Escape para salir.
  document.addEventListener('keydown', (e) => {
    const enCampo =
      e.target instanceof HTMLElement &&
      ['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName);
    if (e.key === '/' && !enCampo) {
      e.preventDefault();
      buscador?.focus();
      buscador?.select();
    }
    if (e.key === 'Escape' && document.activeElement === buscador) {
      if (buscador) buscador.value = '';
      buscador?.blur();
      aplicar();
    }
  });

  // El botón de acción vive dentro del <summary>: sin esto, cada click
  // desplegaría la fila además de abrir WhatsApp o Gmail.
  document.querySelectorAll('[data-accion]').forEach((el) => {
    el.addEventListener('click', (e) => e.stopPropagation());
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const texto = btn.closest('[data-lead]')?.querySelector('[data-mensaje]')?.textContent ?? '';
      if (!texto) return;
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(texto.trim());
        btn.textContent = 'Copiado';
      } catch {
        btn.textContent = 'No se pudo';
      }
      setTimeout(() => { btn.textContent = original; }, 1800);
    });
  });
</script>
