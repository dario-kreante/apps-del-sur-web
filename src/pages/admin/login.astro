---
import '../../styles/global.css';

export const prerender = false;

const error = Astro.url.searchParams.get('error');
const mensaje =
  error === 'config'
    ? 'El panel no está configurado en el servidor. Faltan variables de entorno.'
    : error
      ? 'Usuario o contraseña incorrectos.'
      : null;
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar · Apps del Sur</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex h-full items-center justify-center bg-emerald-900 px-4 antialiased">
    <div class="w-full max-w-sm">
      <div class="mb-6 text-center">
        <p class="text-sm font-semibold tracking-tight text-white">Apps del Sur</p>
        <p class="mt-1 text-xs uppercase tracking-wider text-emerald-300">Panel interno</p>
      </div>

      <form
        method="POST"
        action="/api/admin/login"
        class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm"
      >
        {
          mensaje && (
            <p
              role="alert"
              class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800"
            >
              {mensaje}
            </p>
          )
        }

        <label class="block">
          <span class="text-sm font-medium text-gray-700">Usuario</span>
          <input
            type="text"
            name="user"
            required
            autocomplete="username"
            autofocus
            class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none"
          />
        </label>

        <label class="mt-4 block">
          <span class="text-sm font-medium text-gray-700">Contraseña</span>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500 focus:outline-none"
          />
        </label>

        <button
          type="submit"
          class="mt-6 w-full cursor-pointer rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-emerald-800"
        >
          Entrar
        </button>
      </form>
    </div>
  </body>
</html>
