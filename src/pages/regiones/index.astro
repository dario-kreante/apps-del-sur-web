---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { allRegions } from '../../data/regiones';

const regions = Object.values(allRegions);

const meta = {
  title: 'Software a medida por región — Centro-Sur de Chile | Apps del Sur',
  description:
    'Software a medida y agentes IA para pymes del centro-sur de Chile. Equipo local en O\'Higgins, Maule, Ñuble, Biobío y La Araucanía. Financiamiento CORFO y SERCOTEC disponible.',
  keywords:
    'software a medida centro-sur Chile, software pymes regiones, desarrollo software Maule, software O\'Higgins, software Ñuble, software Biobío, software Araucanía',
};

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://appsdelsur.cl' },
    { '@type': 'ListItem', position: 2, name: 'Regiones', item: 'https://appsdelsur.cl/regiones/' },
  ],
});

const collectionLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.title,
  description: meta.description,
  url: 'https://appsdelsur.cl/regiones/',
  hasPart: regions.map((r) => ({
    '@type': 'WebPage',
    name: `Software a medida ${r.nameWithArticle}`,
    url: `https://appsdelsur.cl/regiones/${r.slug}/`,
  })),
});
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical="https://appsdelsur.cl/regiones/"
  keywords={meta.keywords}
  ogTitle={meta.title}
  ogDescription={meta.description}
>
  <script type="application/ld+json" set:html={breadcrumbLd} />
  <script type="application/ld+json" set:html={collectionLd} />

  <Header />

  <main id="main-content" class="pt-24">
    <!-- Breadcrumb -->
    <div class="max-w-[1200px] mx-auto px-6 mb-6">
      <nav class="text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="text-emerald-600 hover:text-emerald-700 transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-gray-400">Regiones</span>
      </nav>
    </div>

    <!-- Hero -->
    <section class="max-w-[1200px] mx-auto px-6 pb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 max-w-3xl">
        Software a medida para empresas del <span class="text-emerald-600">centro-sur de Chile</span>
      </h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl">
        Equipo local que construye sistemas de gestión, apps móviles y agentes IA adaptados a la
        operación real de cada pyme. Elija su región para ver rubros, dolores frecuentes y el
        financiamiento público disponible.
      </p>
    </section>

    <!-- Region grid -->
    <section class="max-w-[1200px] mx-auto px-6 pb-20">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {regions.map((r) => (
          <li>
            <a
              href={`/regiones/${r.slug}/`}
              class="block h-full rounded-2xl border border-gray-200 p-6 transition-colors hover:border-emerald-400 hover:bg-emerald-50/40"
            >
              <h2 class="text-xl font-semibold text-gray-900">
                Región {r.nameWithArticle}
              </h2>
              <p class="mt-2 text-sm text-gray-600">{r.hero.subtitle}</p>
              <span class="mt-4 inline-block text-sm font-medium text-emerald-600">
                Ver software {r.nameWithArticle} →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <Footer />
</Layout>
