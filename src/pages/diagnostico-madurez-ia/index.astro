---
import Layout from '../../layouts/Layout.astro';
import LogoLockup from '../../components/LogoLockup.astro';

const title = 'Diagnóstico gratuito de madurez en IA para empresas chilenas';
const description = 'Autoevaluación de 20 preguntas (~8 min) para conocer en qué etapa de transformación digital e IA está tu empresa. 5 dimensiones inspiradas en el ITD chileno, gráficos y plan de acción personalizado. Sin costo.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Diagnóstico de Madurez en IA — Apps del Sur',
  description,
  url: 'https://appsdelsur.cl/diagnostico-madurez-ia/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CLP' },
  provider: { '@type': 'Organization', name: 'Apps del Sur', url: 'https://appsdelsur.cl' },
  inLanguage: 'es-CL',
  audience: { '@type': 'BusinessAudience', audienceType: 'Empresas chilenas' },
});
---

<Layout title={`${title} | Apps del Sur`} description={description}>
  <script type="application/ld+json" set:html={jsonLd} />

  <header class="fixed top-0 left-0 right-0 z-50 bg-white/85 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center shrink-0" aria-label="Apps del Sur — Inicio">
        <LogoLockup class="h-14 w-auto sm:h-16" />
      </a>
      <nav class="flex items-center gap-4">
        <a href="/blog/" class="text-sm text-gray-600 hover:text-gray-900 transition-colors">Blog</a>
        <a href="/#contacto" class="text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 px-4 py-2 rounded-lg transition-colors">Contacto</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="pt-24 pb-16 bg-emerald-50/30 min-h-screen">
    <div class="max-w-3xl mx-auto px-6">
      <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="text-emerald-600 hover:text-emerald-700 transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-gray-400">Diagnóstico de madurez en IA</span>
      </nav>

      <div id="panel" class="bg-white border border-gray-200 rounded-2xl p-7 md:p-10 shadow-sm"></div>

      <p class="text-center text-xs text-gray-500 mt-6">
        Tus respuestas quedan solo en tu navegador. Si recargas la página, retomas donde quedaste.
      </p>
    </div>
  </main>

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-emerald-900 text-white px-4 py-2 rounded-full text-sm opacity-0 pointer-events-none transition-opacity shadow-lg z-50"></div>

  <style is:global>
    .opt-card { background: #ecfdf5; border: 1.5px solid transparent; transition: all 0.15s ease; }
    @media (hover: hover) {
      .opt-card:hover:not(.selected) { background: #d1fae5; border-color: #6ee7b7; }
    }
    .opt-card.selected { background: #d1fae5; border-color: #047857; box-shadow: 0 4px 14px rgba(4, 120, 87, 0.15); }
    .opt-card .num { background: white; color: #047857; border: 1px solid #6ee7b7; }
    .opt-card.selected .num { background: #047857; color: white; border-color: #047857; }

    .stage-scale-item {
      border: 1px solid #d1fae5;
      background: #f0fdf4;
      color: #065f46;
      border-radius: 0.75rem;
      padding: 0.65rem 0.75rem;
      font-size: 0.72rem;
      font-weight: 700;
      line-height: 1.2;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .stage-scale-item span {
      display: inline-grid;
      place-items: center;
      width: 1.25rem;
      height: 1.25rem;
      margin-right: 0.35rem;
      border-radius: 0.45rem;
      background: white;
      color: #047857;
      border: 1px solid #a7f3d0;
    }
    .stage-scale-item.active {
      background: #047857;
      color: white;
      border-color: #047857;
    }
    .stage-scale-item.active span {
      background: white;
      color: #047857;
      border-color: white;
    }

    .insight-card {
      border: 1px solid #d1fae5;
      background: #f0fdf4;
      border-radius: 0.9rem;
      padding: 1rem;
    }
    .insight-card span {
      display: block;
      color: #047857;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      margin-bottom: 0.35rem;
      text-transform: uppercase;
    }
    .insight-card strong {
      display: block;
      color: #064e3b;
      font-size: 1rem;
      line-height: 1.2;
    }
    .insight-card p {
      color: #4b5563;
      font-size: 0.82rem;
      line-height: 1.35;
      margin-top: 0.45rem;
    }
    .insight-card.focus {
      background: #fffbeb;
      border-color: #fde68a;
    }

    .chart-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 1rem;
      padding: 1rem;
    }
    .chart-head {
      margin-bottom: 0.8rem;
    }
    .chart-head span {
      color: #047857;
      display: block;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .chart-head h3 {
      color: #064e3b;
      font-size: 1rem;
      font-weight: 800;
      line-height: 1.2;
      margin-top: 0.25rem;
    }
    .bar-row {
      display: grid;
      gap: 0.45rem;
    }
    .bar-meta {
      align-items: baseline;
      display: flex;
      gap: 0.75rem;
      justify-content: space-between;
    }
    .bar-meta span {
      color: #374151;
      font-size: 0.83rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .bar-meta strong {
      color: #047857;
      font-size: 0.82rem;
      font-weight: 800;
    }
    .bar-track {
      background: #ecfdf5;
      border-radius: 999px;
      height: 0.65rem;
      overflow: hidden;
    }
    .bar-fill {
      background: linear-gradient(90deg, #10b981, #047857);
      border-radius: inherit;
      height: 100%;
      min-width: 0.65rem;
    }

    .lead-gate-list {
      display: grid;
      gap: 0.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .lead-gate-list li::before {
      content: '✓';
      color: #047857;
      font-weight: 800;
      margin-right: 0.45rem;
    }
    .locked-label {
      background: #f9fafb;
      border: 1px dashed #d1d5db;
      border-radius: 0.75rem;
      color: #4b5563;
      font-size: 0.82rem;
      margin-bottom: 1rem;
      padding: 0.75rem 1rem;
      text-align: center;
    }
    .locked-content {
      filter: blur(5px);
      max-height: 520px;
      overflow: hidden;
      pointer-events: none;
      position: relative;
      user-select: none;
    }
    .locked-content::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.85) 80%);
    }

    .matrix-cell.s1 { background: #ecfdf5; }
    .matrix-cell.s2 { background: #a7f3d0; }
    .matrix-cell.s3 { background: #34d399; color: white; }
    .matrix-cell.s4 { background: #065f46; color: white; }
    .matrix-cell.active { outline: 3px solid #ca8a04; outline-offset: -2px; position: relative; }
    .matrix-cell.active::after { content: 'TÚ'; position: absolute; top: 4px; right: 4px; background: #ca8a04; color: white; font-size: 9px; font-weight: 800; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.5px; }

    @media print {
      header, #toast, .no-print { display: none !important; }
      main { padding-top: 0; background: white; }
      #panel { box-shadow: none; border: none; padding: 0; }
    }
  </style>

  <script src="/diagnostico-app.js" is:inline></script>
</Layout>
