---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';
import { topicFor } from '../lib/blog';
import ROICalculator from '../components/ROICalculator.astro';
import { siteConfig } from '../data/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogHead from '../components/blog/BlogHead.astro';
import AuthorAvatar from '../components/blog/AuthorAvatar.astro';
import { heroComponents } from '../components/blog-heroes';
import '../styles/blog.css';



interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  readingTime: string;
  heroAlt: string;
  heroImage?: string;
  images?: Array<{
    url: string;
    title: string;
    caption?: string;
  }>;
  tags: string[];
  relatedPosts?: string[];
  slug: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, pubDate, updatedDate, author, readingTime, heroAlt, heroImage, images, tags, relatedPosts, slug, headings = [] } = Astro.props;
const allPosts = await getCollection('blog');
const related = (relatedPosts ?? []).map(id => allPosts.find(post => post.id === id)).filter(Boolean);
const topic = topicFor(slug);
const isField = topic.id === 'campo';
const toc = headings.filter(heading => heading.depth === 2);

const HeroComponent = heroComponents[slug];

const formattedDate = pubDate.toLocaleDateString('es-CL', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('es-CL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const canonicalUrl = `https://appsdelsur.cl/blog/${slug}/`;
const primaryImage = heroImage ? `https://appsdelsur.cl${heroImage}` : siteConfig.ogImage;
const articleImages = Array.from(
  new Set([primaryImage, ...(images ?? []).map((image) => `https://appsdelsur.cl${image.url}`)])
);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  inLanguage: 'es-CL',
  articleSection: topic.label,
  keywords: tags.join(', '),
  isPartOf: { '@type': 'Blog', '@id': 'https://appsdelsur.cl/blog/#collection', name: 'Blog de Apps del Sur' },
  headline: title,
  description: description,
  image: articleImages,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    url: `${canonicalUrl}#autor`,
    affiliation: {
      '@type': 'Organization',
      name: 'GYS Activa SpA',
    },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Apps del Sur',
    logo: {
      '@type': 'ImageObject',
      url: 'https://appsdelsur.cl/brand/logo-stacked.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
}).replaceAll('<', '\\u003c');
const breadcrumbSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://appsdelsur.cl/' }, { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://appsdelsur.cl/blog/' }, { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl }] }).replaceAll('<', '\\u003c');
const relatedCards = related.slice(0, 3);
const shareText = encodeURIComponent(`${title} ${canonicalUrl}`);
const shareUrl = encodeURIComponent(canonicalUrl);

---

<Layout
  title={`${title} | Apps del Sur`}
  description={description}
  canonical={canonicalUrl}
  ogTitle={title}
  ogDescription={description}
  ogImage={primaryImage}
  ogImageAlt={heroAlt}
  ogType="article"
  omitFaqSchema
>
  <BlogHead slot="head" />
  <script type="application/ld+json" set:html={jsonLd} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />

  <Header />
  <div class="blog-progress" data-reading-progress aria-hidden="true"></div>

  <main id="main-content" class="blog pt-16">
    <article>
      <header class="blog-column pt-10 md:pt-14">
        <nav class="text-sm text-[var(--muted)]" aria-label="Breadcrumb">
          <a href="/blog/" class="hover:text-[var(--ink)] transition-colors">Blog</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <a href={`/blog/?tema=${topic.id}`} class="hover:text-[var(--ink)] transition-colors">{topic.label}</a>
        </nav>

        <h1 class="blog-title mt-6">{title}</h1>
        <p class="blog-subtitle">{description}</p>

        <div class="flex items-center gap-3 mt-8 mb-7">
          <AuthorAvatar name={author} />
          <div class="text-[15px] leading-snug">
            <a href="#autor" class="font-medium hover:underline underline-offset-4">{author}</a>
            <span class="text-[var(--muted)]"> en Apps del Sur</span>
            <p class="text-sm text-[var(--muted)] mt-0.5">
              <span>{readingTime} de lectura</span>
              <span class="mx-1.5" aria-hidden="true">·</span>
              <time datetime={pubDate.toISOString()}>{formattedDate}</time>
              {formattedUpdatedDate && <span class="ml-1.5">(actualizado el {formattedUpdatedDate})</span>}
            </p>
          </div>
        </div>

        <div class="blog-actions">
          <a href={`/blog/?tema=${topic.id}`} class="blog-chip">{topic.label}</a>
          <div class="blog-actions__share">
            <a class="blog-icon-btn" href={`https://wa.me/?text=${shareText}`} target="_blank" rel="noopener" aria-label="Compartir por WhatsApp">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3.5 20.5l1.3-4A8.5 8.5 0 1 1 8 19.3z"/><path d="M9 8.6c.2 2.6 2.1 5 4.9 5.9l1.3-1.3 2 1-.6 1.6c-3.9.3-8.2-3.7-8.4-7.6l1.6-.6 1 2z"/></svg>
              <span>WhatsApp</span>
            </a>
            <a class="blog-icon-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener" aria-label="Compartir en LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg>
              <span>LinkedIn</span>
            </a>
            <button type="button" class="blog-icon-btn" data-copy-link={canonicalUrl}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
              <span data-copy-label>Copiar enlace</span>
            </button>
          </div>
        </div>
      </header>

      {HeroComponent && (
        <div class="blog-column mt-10">
          <div class="overflow-hidden rounded" role="img" aria-label={heroAlt}>
            <HeroComponent class="w-full h-auto" />
          </div>
        </div>
      )}
      {!HeroComponent && heroImage && (
        <div class="blog-column mt-10">
          <img src={heroImage} alt={heroAlt} width="1536" height="1024" loading="eager" decoding="async" fetchpriority="high" class="w-full h-auto rounded" />
        </div>
      )}

      <div class="blog-column">
        {toc.length > 2 && (
          <details class="blog-toc">
            <summary>En este artículo</summary>
            <nav aria-label="Índice del artículo"><ol>{toc.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>
          </details>
        )}

        <div class="blog-body">
          <slot />
        </div>

        {slug === 'calcular-roi-proyecto-ia-pyme-chile' && <div class="mt-10"><ROICalculator /></div>}

        <div class="blog-tags">
          {tags.map((tag) => <span class="blog-chip">{tag}</span>)}
        </div>

        <aside id="autor" class="blog-author" aria-label="Autor">
          <AuthorAvatar name={author} size="lg" />
          <div>
            <p class="text-sm text-[var(--muted)]">Escrito por</p>
            <p class="blog-author__name">{author}</p>
          </div>
          <p>Apps del Sur es una consultora boutique de software a medida e IA aplicada, con base en Talca. Trabajamos pocos proyectos a la vez y con el mismo equipo de punta a punta. <a href="/nosotros/" class="text-[var(--brand-deep)] underline underline-offset-4">Quiénes somos</a></p>
        </aside>

        <section class="blog-next" aria-labelledby="next-title">
          <h2 id="next-title">{isField ? 'Del cuaderno de papel al costo por hectárea' : '¿Qué proceso te gustaría simplificar?'}</h2>
          <p>{isField ? 'Revisemos cómo registras hoy las labores y qué necesitaría tu operación. No reemplaza tu contabilidad: se conecta con ella.' : 'Cuéntanos dónde se repite el trabajo en tu empresa y vemos un primer paso concreto, sin costo.'}</p>
          <div class="mt-5 flex flex-wrap items-center gap-4">
            <a href="/#contacto" class="inline-flex items-center rounded-full bg-[var(--brand)] px-5 py-2.5 text-sm font-medium text-white hover:bg-[var(--brand-deep)] transition-colors">Conversemos</a>
            <a href={isField ? '/cuaderno-de-campo/' : '/diagnostico-madurez-ia/'} class="text-sm font-medium text-[var(--brand-deep)] underline underline-offset-4">{isField ? 'Conocer el cuaderno de campo' : 'Hacer el diagnóstico de madurez en IA'}</a>
          </div>
        </section>
      </div>
    </article>

    {relatedCards.length > 0 && (
      <section class="blog-more" aria-labelledby="more-title">
        <div class="max-w-[1100px] mx-auto px-6">
          <h2 id="more-title" class="text-xl font-bold mb-8">Más del blog de Apps del Sur</h2>
          <div class="blog-more__grid">
            {relatedCards.map((post) => {
              const Hero = heroComponents[post!.id];
              return (
                <article class="blog-more__card">
                  {Hero && <a href={`/blog/${post!.id}/`} class="blog-thumb" tabindex="-1" aria-hidden="true"><Hero /></a>}
                  <div class="blog-feed-item__byline mb-2">
                    <AuthorAvatar name={post!.data.author} size="sm" />
                    <span>{topicFor(post!.id).label}</span>
                  </div>
                  <h3><a href={`/blog/${post!.id}/`}>{post!.data.title}</a></h3>
                  <p>{post!.data.description}</p>
                  <p class="!font-sans !text-[13px] mt-3">{post!.data.readingTime} de lectura</p>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const body = document.querySelector<HTMLElement>('.blog-body');
  if (bar && body) {
    const update = () => {
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const progress = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
      bar.style.transform = `scaleX(${progress})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
    button.addEventListener('click', async () => {
      const label = button.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink!);
        if (label) label.textContent = 'Enlace copiado';
      } catch {
        if (label) label.textContent = 'No se pudo copiar';
      }
      setTimeout(() => { if (label) label.textContent = 'Copiar enlace'; }, 2000);
    });
  }
</script>

<style is:global>
  .blog-body pre { overflow-x: auto; padding: 16px; background: #f2f4f2; border-radius: 4px; font-size: 15px; }
  .blog-body a { overflow-wrap: anywhere; }
</style>
