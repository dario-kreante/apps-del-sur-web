---
import '../styles/global.css';

interface Props {
  title: string;
  activo: 'pipeline' | 'proyectos';
}

const { title, activo } = Astro.props;

const nav = [
  { href: '/admin', label: 'Pipeline', key: 'pipeline' },
  { href: '/admin/proyectos', label: 'Proyectos', key: 'proyectos' },
] as const;
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Apps del Sur</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="h-full bg-gray-50 text-gray-900 antialiased">
    <header class="sticky top-0 z-20 border-b border-emerald-800 bg-emerald-900">
      <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3 sm:px-6">
        <a href="/admin" class="flex items-center gap-2 text-white">
          <span class="text-sm font-semibold tracking-tight">Apps del Sur</span>
          <span class="rounded bg-emerald-700 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-emerald-100">
            Panel
          </span>
        </a>

        <nav class="flex items-center gap-1" aria-label="Secciones">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={activo === item.key ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
                  activo === item.key
                    ? 'bg-emerald-700 text-white'
                    : 'text-emerald-100 hover:bg-emerald-800 hover:text-white',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <form method="POST" action="/api/admin/logout" class="ml-auto">
          <button
            type="submit"
            class="cursor-pointer rounded-lg px-3 py-1.5 text-sm text-emerald-200 transition-colors hover:bg-emerald-800 hover:text-white"
          >
            Salir
          </button>
        </form>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <slot />
    </main>
  </body>
</html>
