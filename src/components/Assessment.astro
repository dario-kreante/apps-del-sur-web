---
import assessments from '../data/assessments.json';

interface Props {
  type: 'ia' | 'digital' | 'datos';
  embedded?: boolean;
}

const { type, embedded = false } = Astro.props;
const assessment = assessments[type];
const assessmentJson = JSON.stringify({ type, ...assessment }).replace(/</g, '\\u003c');
const title = { ia: 'Diagnóstico de Madurez en IA', digital: 'Diagnóstico de Madurez Digital', datos: 'Diagnóstico de Datos Personales' }[type];
const Wrapper = embedded ? 'section' : 'main';
const wrapperProps = embedded ? { id: 'autodiagnostico', 'aria-label': title } : { id: 'main-content' };
const privacyNote = type === 'datos'
  ? 'Sus respuestas se guardan en este navegador para que pueda continuar después. Solo se envían si completa y acepta el formulario final.'
  : 'Tus respuestas se guardan en este navegador para que puedas continuar después. Solo se envían si completas y aceptas el formulario final.';
---

<link rel="stylesheet" href="/assessment.css" />
<Wrapper {...wrapperProps} class:list={['assessment-page', embedded && 'assessment-page-embedded']}>
  <div class="assessment-wrap">
    {!embedded && (
      <nav class="assessment-breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/diagnosticos/">Diagnósticos</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span>
      </nav>
    )}
    <div id="assessment-app" class="assessment-card" data-assessment-type={type}>
      <noscript>
        {embedded ? <h2>{title}</h2> : <h1>{title} para empresas chilenas</h1>}
        <p>Este diagnóstico interactivo requiere JavaScript. Si prefieres, <a href="/#contacto">contáctanos</a> y te orientamos.</p>
      </noscript>
    </div>
    <p class="assessment-privacy">{privacyNote}</p>
  </div>
</Wrapper>
<script id="assessment-data" type="application/json" set:html={assessmentJson}></script>
<script src="/assessment-app.js" is:inline></script>
<script>
  import '../scripts/assessment-pdf';
</script>
