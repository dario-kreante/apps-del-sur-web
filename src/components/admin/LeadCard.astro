---
import type { Canal } from '../../lib/admin/canales';

interface Props {
  id: string;
  empresa: string;
  rubro: string;
  region: string;
  etapa: string;
  contacto: string;
  cargo: string;
  email: string;
  telefono: string;
  angulo: string;
  borrador: string;
  toques: number;
  respondio: boolean;
  control: string;
  proximaAccion: string;
  canal: Canal;
  waHref: string | null;
  mailHref: string | null;
  mockupUrl: string | null;
  dossier: string;
}

const {
  id, empresa, rubro, region, etapa, contacto, cargo, email, telefono,
  angulo, borrador, toques, respondio, control, proximaAccion,
  canal, waHref, mailHref, mockupUrl, dossier,
} = Astro.props;

const canalMeta: Record<Canal, { label: string; clase: string }> = {
  email: { label: 'Correo', clase: 'bg-emerald-100 text-emerald-800' },
  whatsapp: { label: 'WhatsApp · manual', clase: 'bg-amber-100 text-amber-800' },
  llamada: { label: 'Llamada · manual', clase: 'bg-orange-100 text-orange-800' },
  manual: { label: 'Sin canal', clase: 'bg-gray-100 text-gray-700' },
};

const listoParaEnviar = control === 'Aprobado para enviar';
const tieneBorrador = borrador.trim().length > 0;
---

<article
  class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm"
  data-lead-card
>
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-base font-semibold tracking-tight text-gray-900">
        {empresa}
      </h3>
      <p class="mt-0.5 text-sm text-gray-600">
        {contacto || <span class="text-red-700">Sin contacto nominal</span>}
        {cargo && <span class="text-gray-400"> · {cargo}</span>}
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-1.5">
      <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${canalMeta[canal].clase}`}>
        {canalMeta[canal].label}
      </span>
      <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700">
        {rubro}
      </span>
      {respondio && (
        <span class="rounded-full bg-cyan-100 px-2.5 py-0.5 text-xs font-medium text-cyan-800">
          Respondió
        </span>
      )}
    </div>
  </header>

  <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-gray-500">
    <div><dt class="inline">Etapa: </dt><dd class="inline font-medium text-gray-700">{etapa || '—'}</dd></div>
    <div><dt class="inline">Toques: </dt><dd class="inline font-medium text-gray-700 tabular-nums">{toques ?? 0}</dd></div>
    {region && <div><dt class="inline">Región: </dt><dd class="inline font-medium text-gray-700">{region}</dd></div>}
    <div><dt class="inline">Compuerta: </dt><dd class="inline font-medium text-gray-700">{control || 'Pendiente'}</dd></div>
  </dl>

  {angulo && (
    <div class="mt-4 rounded-lg border-l-2 border-emerald-600 bg-emerald-50/60 px-3 py-2">
      <p class="text-[11px] font-medium uppercase tracking-wider text-emerald-800">
        Dónde aportamos valor
      </p>
      <p class="mt-1 text-sm leading-relaxed text-gray-800">{angulo}</p>
    </div>
  )}

  {tieneBorrador && (
    <details class="group mt-4">
      <summary class="flex cursor-pointer items-center gap-1.5 text-sm font-medium text-emerald-800 hover:text-emerald-900">
        <span>Ver el mensaje</span>
        <span class="text-xs text-gray-400 group-open:hidden">
          ({borrador.trim().split(/\s+/).length} palabras)
        </span>
      </summary>
      <pre
        class="mt-2 max-h-72 overflow-auto rounded-lg bg-gray-50 p-3 text-sm leading-relaxed whitespace-pre-wrap text-gray-800"
        data-mensaje>{borrador}</pre>
    </details>
  )}

  <div class="mt-4 flex flex-wrap items-center gap-2">
    {canal === 'email' && mailHref && tieneBorrador && (
      <a
        href={mailHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-9 items-center gap-1.5 rounded-lg bg-emerald-700 px-4 text-sm font-medium text-white transition-colors hover:bg-emerald-800"
      >
        Abrir en Gmail
      </a>
    )}

    {canal === 'whatsapp' && waHref && tieneBorrador && (
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-9 items-center gap-1.5 rounded-lg bg-emerald-700 px-4 text-sm font-medium text-white transition-colors hover:bg-emerald-800"
      >
        Abrir WhatsApp con el mensaje
      </a>
    )}

    {canal === 'llamada' && telefono && (
      <a
        href={`tel:${telefono.replace(/\s/g, '')}`}
        class="inline-flex min-h-9 items-center gap-1.5 rounded-lg bg-orange-600 px-4 text-sm font-medium text-white transition-colors hover:bg-orange-700"
      >
        Llamar a {telefono}
      </a>
    )}

    {canal !== 'whatsapp' && waHref && tieneBorrador && (
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        title="Tiene móvil: sirve como alternativa si el canal principal no responde"
        class="inline-flex min-h-9 items-center rounded-lg border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
      >
        WhatsApp
      </a>
    )}

    {tieneBorrador && (
      <button
        type="button"
        data-copiar
        class="inline-flex min-h-9 cursor-pointer items-center rounded-lg border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
      >
        Copiar mensaje
      </button>
    )}

    {mockupUrl && (
      <a
        href={mockupUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-9 items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
      >
        <img src={mockupUrl} alt="" class="h-6 w-9 rounded object-cover" />
        Mockup
      </a>
    )}

    {dossier && (
      <a
        href={dossier}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-9 items-center rounded-lg px-2 text-sm text-gray-500 transition-colors hover:text-gray-900"
      >
        Dossier
      </a>
    )}
  </div>

  {!tieneBorrador && canal !== 'llamada' && (
    <p class="mt-3 rounded-lg bg-gray-50 px-3 py-2 text-xs text-gray-600">
      Falta redactar el mensaje. Sin eso no hay nada que enviar.
    </p>
  )}

  {canal === 'whatsapp' && mockupUrl && tieneBorrador && (
    <p class="mt-2 text-xs text-gray-500">
      El link deja el texto escrito; el mockup se adjunta a mano en la conversación.
    </p>
  )}

  {proximaAccion && (
    <p class="mt-4 border-t border-gray-100 pt-3 text-xs text-gray-500">
      <span class="font-medium text-gray-700">Próxima acción:</span> {proximaAccion}
    </p>
  )}

  <form
    method="POST"
    action="/admin/acciones/lead/"
    class="mt-3 flex flex-wrap items-center gap-2 border-t border-gray-100 pt-3"
  >
    <input type="hidden" name="id" value={id} />
    <input type="hidden" name="empresa" value={empresa} />
    <input type="hidden" name="canal" value={canal} />
    <button
      type="submit"
      name="accion"
      value="registrar-toque"
      disabled={!listoParaEnviar}
      title={listoParaEnviar
        ? 'Registra el toque y programa el siguiente'
        : 'Marcá la compuerta como "Aprobado para enviar" en Airtable primero'}
      class="inline-flex min-h-8 cursor-pointer items-center rounded-lg border border-emerald-200 bg-emerald-50 px-3 text-xs font-medium text-emerald-800 transition-colors hover:bg-emerald-100 disabled:cursor-not-allowed disabled:border-gray-200 disabled:bg-gray-50 disabled:text-gray-400"
    >
      Marcar enviado
    </button>
    <button
      type="submit"
      name="accion"
      value="marcar-respondio"
      class="inline-flex min-h-8 cursor-pointer items-center rounded-lg border border-gray-200 bg-white px-3 text-xs font-medium text-gray-700 transition-colors hover:bg-gray-50"
    >
      Respondió
    </button>
    <button
      type="submit"
      name="accion"
      value="cerrar-perdido"
      class="inline-flex min-h-8 cursor-pointer items-center rounded-lg px-3 text-xs text-gray-500 transition-colors hover:text-red-700"
    >
      Cerrar
    </button>
  </form>
</article>
