---
import { getCollection } from 'astro:content';
import { blogHighlights } from '../data/content';
import ArrowRight from './icons/ArrowRight.astro';

const allPosts = await getCollection('blog');
const postsBySlug = new Map(allPosts.map((post) => [post.id, post]));

const destacados = blogHighlights.slugs
  .map((slug) => ({ slug, post: postsBySlug.get(slug) }))
  .filter((x) => x.post);
---

{destacados.length > 0 && (
  <section class="py-20 bg-gray-50">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-emerald-700 mb-2">{blogHighlights.label}</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight mb-3">
            {blogHighlights.title}
          </h2>
          <p class="text-gray-600 leading-relaxed">
            {blogHighlights.description}
          </p>
        </div>
        <a
          href={blogHighlights.ctaAllHref}
          class="text-emerald-700 font-medium text-sm inline-flex items-center gap-1.5 hover:gap-2.5 transition-all shrink-0 min-h-[44px]"
        >
          {blogHighlights.ctaAll}
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {destacados.map(({ slug, post }) => (
          <a
            href={`/blog/${slug}/`}
            class="group flex flex-col bg-white rounded-xl border border-gray-200 p-6 hover:border-emerald-300 hover:shadow-md transition-all"
          >
            <div class="flex items-center gap-2 mb-3 text-xs text-gray-500">
              <span class="inline-flex items-center bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-medium">
                Artículo
              </span>
              {post.data.readingTime && <span>· {post.data.readingTime}</span>}
            </div>
            <h3 class="font-semibold text-gray-900 text-base mb-2 leading-snug group-hover:text-emerald-700 transition-colors">
              {post.data.title}
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed line-clamp-3 flex-1">
              {post.data.description}
            </p>
            <span class="text-emerald-700 font-medium text-sm mt-4 inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
              Leer artículo
              <ArrowRight class="w-4 h-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
