---
import type { PricingTier } from '../../data/agentes';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import ArrowRight from '../icons/ArrowRight.astro';

interface Props {
  ventaUnica: PricingTier[];
  whatsappUrl: string;
}

const { ventaUnica, whatsappUrl } = Astro.props;

// Fondos que suelen aplicar a esta página, sin repetir y en el orden de los datos.
// Se quitan detalles como "+ aporte propio" o "(proyecto sectorial)" para no duplicar chips.
const fondos = [
  ...new Set(
    ventaUnica
      .map((tier) => tier.fondo?.replace(/\s*\+.*$|\s*\(.*\)$/, '').replace(/^Kit Digital$/, 'Kit Digital SERCOTEC'))
      .filter(Boolean),
  ),
];

const steps = [
  {
    title: 'Conversación inicial',
    description: 'Sin costo. Nos cuenta cómo opera hoy y qué quiere resolver primero.',
  },
  {
    title: 'Diagnóstico de su operación',
    description: 'Revisamos procesos, volumen e integraciones con quienes usarán el sistema.',
  },
  {
    title: 'Propuesta cerrada',
    description: 'Alcance, plazos, inversión y el fondo público que puede cofinanciarla.',
  },
];
---

<section class="py-20 bg-gray-50">
  <div class="max-w-[1100px] mx-auto px-6">
    <SectionHeader
      label="Inversión"
      title="Cómo se define la inversión"
      description="No trabajamos con planes de catálogo. Tomamos pocos proyectos a la vez y cada propuesta parte de entender su operación."
      centered
    />

    <ol class="grid md:grid-cols-3 gap-6 mb-8">
      {steps.map((step, i) => (
        <li class="rounded-xl border border-gray-200 bg-white p-7">
          <div class="text-sm font-semibold text-emerald-700 mb-2">Paso {String(i + 1).padStart(2, '0')}</div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>

    <div class="rounded-xl border border-emerald-100 bg-white p-7 md:p-8 flex flex-col md:flex-row md:items-center gap-6">
      <div class="flex-1 space-y-3">
        <p class="text-sm text-gray-700">
          <span class="font-semibold text-gray-900">Modalidad:</span> compra con implementación o suscripción mensual. La definimos con usted en la propuesta, según lo que más le conviene.
        </p>
        {fondos.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm font-semibold text-gray-900">Fondos que suelen aplicar:</span>
            {fondos.map((fondo) => (
              <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-medium">{fondo}</span>
            ))}
          </div>
        )}
      </div>
      <Button href={whatsappUrl} target="_blank" size="lg" class="w-full md:w-auto md:shrink-0">
        Agendar conversación
        <ArrowRight class="w-5 h-5 shrink-0" />
      </Button>
    </div>

    <p class="text-center text-sm text-gray-500 mt-8 max-w-[640px] mx-auto">
      Los costos de WhatsApp Business API (Meta) se cobran aparte (~$10-30 CLP por conversación iniciada).
    </p>
  </div>
</section>
